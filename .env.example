DATABASE_PASSWORD=procurax-local

# Spring Boot OAuth2/OIDC (Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SPRING_PROFILES_ACTIVE=oauth
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# SESSION_COOKIE_SAME_SITE=Lax

# Cloudinary document storage (required for Spring multipart uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Redis/Kafka/PostgreSQL service configuration
# REDIS_HOST=localhost
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# DATABASE_URL=jdbc:postgresql://localhost:5432/procurax
# DATABASE_USERNAME=procurax

# Optional host port overrides if defaults are already in use
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# KAFKA_PORT=9092
# KAFKA_UI_PORT=8081
# BACKEND_PORT=8080
# GATEWAY_PORT=8088
# GATEWAY_CONNECT_TIMEOUT_MS=5000
# GATEWAY_RATE_LIMIT_REQUESTS=120
# GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# GATEWAY_MAX_TRACKED_CLIENTS=20000
# AI_PLATFORM_PORT=8001
# Set a random value of at least 32 characters before calling the internal procurement planner.
# PROCURAX_AI_SERVICE_TOKEN=
